  "devDependencies": {
    "@blackbox/eslint-config": "workspace:*",
    "@blackbox/typescript-config": "workspace:*",
    "@tailwindcss/vite": "^4.1.8",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.15.29",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.5.1",
    "electron": "^36.3.2",
    "electron-builder": "^26.0.12",
    "electron-vite": "^3.1.0",
    "eslint": "^9.28.0",
    "tailwindcss": "^4.1.8",
