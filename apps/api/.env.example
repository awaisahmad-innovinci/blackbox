# NestJS API — copy to apps/api/.env
# Never commit real secrets.

NODE_ENV=development
PORT=4000

# Postgres (Supabase) connection used by TypeORM. Required.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# JWT. Required; use long random strings.
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800

# Comma-separated browser origins allowed to call the API (web + platform).
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Email (Brevo) for password reset.
BREVO_API_KEY=
EMAIL_FROM=
EMAIL_SENDER_NAME=Blackbox
PASSWORD_RESET_OTP_TTL_SECONDS=600

# Key that encrypts supervisor TOTP secrets at rest. Optional: falls back to JWT_ACCESS_SECRET.
# Never change it once set, or stored TOTP secrets can no longer be read.
TOTP_ENCRYPTION_KEY=

# Platform (operator) console login.
PLATFORM_ADMIN_USERNAME=
PLATFORM_ADMIN_PASSWORD=

# Desktop auto-update feed.
DESKTOP_UPDATE_STORAGE_URL=
DESKTOP_UPDATE_BUCKET=
