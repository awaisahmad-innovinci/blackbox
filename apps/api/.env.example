# @blackbox/api environment
# Copy to apps/api/.env and fill in real values. Never commit the real .env.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
# development | production — in development, missing email config only logs the
# OTP to the server console instead of throwing.
NODE_ENV=development
# HTTP port the API listens on (GET /health).
PORT=4000
# Comma-separated list of allowed CORS origins (web + platform + desktop dev).
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ---------------------------------------------------------------------------
# Database (Supabase Postgres)
# ---------------------------------------------------------------------------
# Postgres connection string. Use the Supabase pooled/session connection string.
DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres

# ---------------------------------------------------------------------------
# Auth / JWT
# ---------------------------------------------------------------------------
# Secret used to sign + verify access JWTs. Required (app fails fast without it).
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
# Optional access/refresh lifetimes (seconds). Defaults: 900 (15m) / 604800 (7d).
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
# Optional key used to encrypt supervisor TOTP secrets at rest.
# Falls back to JWT_ACCESS_SECRET when unset.
TOTP_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Platform (operator) admin console
# ---------------------------------------------------------------------------
PLATFORM_ADMIN_USERNAME=
PLATFORM_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Email (Brevo) — REQUIRED for "Forgot password" and email verification OTPs
# ---------------------------------------------------------------------------
# Without BREVO_API_KEY the password-reset code is NOT emailed: in development
# it is only written to the API log, and in production the request fails.
# Only an active OWNER of an active tenant can receive a password reset code.
# Create a Brevo (Sendinblue) account and generate a transactional API key.
BREVO_API_KEY=
# Verified sender address in Brevo (must be an authenticated sender/domain).
EMAIL_FROM=no-reply@yourdomain.com
# Display name shown on outgoing mail (defaults to "Blackbox").
EMAIL_SENDER_NAME=Blackbox
# Password reset OTP lifetime in seconds (default 600 = 10 minutes).
PASSWORD_RESET_OTP_TTL_SECONDS=600

# ---------------------------------------------------------------------------
# Desktop auto-update (optional)
# ---------------------------------------------------------------------------
DESKTOP_UPDATE_BUCKET=
