# Electron desktop — copy to apps/desktop/.env
# Never commit real secrets.

# NestJS API base URL (no trailing slash). Local dev: run pnpm dev:api on this host.
# Remote: deploy the same API revision as desktop — master-data CSV headers follow @blackbox/shared.
VITE_API_URL=http://localhost:4000

# Offline authorization window (days) — must match API OFFLINE_AUTHORIZATION_DAYS
OFFLINE_AUTHORIZATION_DAYS=7
