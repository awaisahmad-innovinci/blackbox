# NestJS API — copy to apps/api/.env and fill in values.
# Never commit real secrets.

NODE_ENV=development
PORT=4000

# Postgres — hosted Supabase (direct or session pooler). No Docker / local supabase.
# Get URI from Supabase Dashboard → Project Settings → Database.
# Must use KEY=value (not KEY:value). SSL required for hosted Supabase.
# Nest DbModule adds uselibpqcompat for Node pg when host is supabase.
# Example (replace USER/PASSWORD/HOST/PORT):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require

# JWT (generate strong secrets for non-local environments)
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars

# Token TTLs
# Access token: 15 minutes (900 seconds)
JWT_ACCESS_TTL_SECONDS=900
# Refresh token: 7 days (604800 seconds)
JWT_REFRESH_TTL_SECONDS=604800

# Desktop offline authorization window after successful online auth on a trusted device
OFFLINE_AUTHORIZATION_DAYS=7

# Phase A warehouse: fixed Demo Store tenant (no JWT on inventory/dashboard routes).
# Must match seeded tenant in supabase/migrations/*_inventory_phase1.sql
DEV_TENANT_ID=a0000000-0000-4000-8000-000000000001

# CORS origins (comma-separated) — web + electron-vite renderer
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Owner forgot-password email (Resend — https://resend.com, free tier)
# Dev: omit RESEND_API_KEY to log OTP in API console instead of sending mail
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev
PASSWORD_RESET_OTP_TTL_SECONDS=600
